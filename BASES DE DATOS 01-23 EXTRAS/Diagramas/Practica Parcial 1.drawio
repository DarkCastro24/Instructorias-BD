        </mxCell>
        <mxCell id="kXmg2r73oNVKODR7tInL-460" value="&lt;b&gt;Atributos compuestos&lt;br&gt;&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1220" y="565" width="166" height="35" as="geometry" />
        </mxCell>
        <mxCell id="kXmg2r73oNVKODR7tInL-461" value="&lt;b&gt;Si existe como mínimo 1 se coloca la línea gruesa&lt;br&gt;&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="526" y="575" width="166" height="35" as="geometry" />
        </mxCell>
        <mxCell id="kXmg2r73oNVKODR7tInL-462" value="&lt;b&gt;Si el mínimo es 0 se deja&lt;br&gt;la línea normal sin marcar&lt;br&gt;&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="580" width="166" height="35" as="geometry" />
        </mxCell>
        <mxCell id="kXmg2r73oNVKODR7tInL-464" value="&lt;b&gt;Atributos multivaluados pueden haber desde 0 a N registros vinculados a esa tabla&lt;br&gt;&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-500" y="515" width="200" height="75" as="geometry" />
        </mxCell>
        <mxCell id="kXmg2r73oNVKODR7tInL-465" value="&lt;b&gt;Llave primaria va subrayada&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-83" y="45" width="184" height="35" as="geometry" />
        </mxCell>
        <mxCell id="kXmg2r73oNVKODR7tInL-466" value="&lt;b&gt;Si en un lado el mínimo 0 y en el otro lado 1 el lado del 1 se coloca línea doble y el otro se deja normal&lt;br&gt;&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="110" y="347.5" width="216" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ND-R7yi-1tHWuxWQdBzL-1" value="&lt;b&gt;Los atributos multivaluados (M) son Forma Normal 1 (FN1)&lt;br&gt;&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-169" y="1500" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ND-R7yi-1tHWuxWQdBzL-2" value="&lt;b&gt;Los catálogos son (FN2)&lt;br&gt;Se coloca la llave foranea en la tabla principal&lt;br&gt;&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="946" y="1770" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ND-R7yi-1tHWuxWQdBzL-3" value="&lt;b&gt;La pata de gallo apunta hacia&lt;br&gt;la tabla que tiene la llave foranea&lt;br&gt;&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="608.5" y="1560" width="186.5" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ND-R7yi-1tHWuxWQdBzL-6" value="&lt;b&gt;Tabla generada de la relacion N:N&lt;br&gt;&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
