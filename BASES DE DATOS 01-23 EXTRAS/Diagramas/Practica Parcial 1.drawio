        </mxCell>
        <mxCell id="ND-R7yi-1tHWuxWQdBzL-8" value="&lt;b&gt;La FN3 consiste en la creación de una tabla adicional separando datos que no dependen de la llave primaria de la tabla principal (Cliente)&lt;br&gt;&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
