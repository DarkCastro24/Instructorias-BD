        <mxCell id="kXmg2r73oNVKODR7tInL-459" value="&lt;b&gt;Atributos multivaluados&lt;br&gt;van en negrita&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
